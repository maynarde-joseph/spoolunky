[resource]
script = ExtResource("3_qpuxa")
id = "hollow_wyrm"
display_name = "The Hollow Wyrm"
description = "The thing the Hollow Wood is named for. It does not keep to a lair: it goes the rounds of the whole wood in the open air, and wherever you are on its beat is where it fights you. It dives, it spits fire from across a room, its wings throw a gust that tears silk down, and its tail sweeps whatever is beside it."
