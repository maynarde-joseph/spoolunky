[resource]
script = ExtResource("1_spell")
id = "fire"
display_name = "Fire Geyser"
description = "A geyser of fire out of the ground under the cross. It throws what it catches up into the air and burns it — and silk burns: the more of a thing is wrapped, the harder it burns. Every web and line in the column burns away, dropping what the web held; a wet web stands, and catches what the geyser throws into it."
